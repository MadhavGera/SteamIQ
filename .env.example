# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steamiq
POSTGRES_USER=steamiq
POSTGRES_PASSWORD=changeme

# ─── Backend ──────────────────────────────────────────────────────────────────
# Explicit origin allowlist — NEVER use * in production
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# FastAPI environment: development | production
APP_ENV=development

# ─── Steam API ────────────────────────────────────────────────────────────────
# Obtain from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ─── Redis (Phase 2+ — RQ job queue) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Points to backend API — NEVER hardcode in source files
NEXT_PUBLIC_API_URL=http://localhost:8001
