# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steamiq
POSTGRES_USER=steamiq
POSTGRES_PASSWORD=changeme

# Constructed by the app from the above — set directly if preferred
# DATABASE_URL=postgresql+asyncpg://steamiq:changeme@localhost:5432/steamiq

# ─── Backend ──────────────────────────────────────────────────────────────────
# Explicit origin allowlist — NEVER use * in production
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# FastAPI environment: development | production
APP_ENV=development

# ─── Steam API ────────────────────────────────────────────────────────────────
# Obtain from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ─── Redis (Phase 2+ — RQ job queue) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Points to backend API — NEVER hardcode localhost in source files
NEXT_PUBLIC_API_URL=http://localhost:8000
