# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steamiq
POSTGRES_USER=steamiq
POSTGRES_PASSWORD=changeme

# ─── Backend ──────────────────────────────────────────────────────────────────
# Explicit origin allowlist — NEVER use * in production
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# FastAPI environment: development | production
APP_ENV=development

# ─── Steam API ────────────────────────────────────────────────────────────────
# Obtain from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ─── Redis (Phase 2+ — RQ job queue) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Frontend ─────────────────────────────────────────────────────────────────
# ADR 0001, Decision 7: Points to backend API — NEVER hardcode in source files
# Client-side API URL (browser calls)
# - Local dev (make dev): http://localhost:8000
# - Docker Compose: http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

# Server-side API URL (SSR / Server Components container-to-container calls)
# - Local dev: http://localhost:8000
# - Docker Compose: http://backend:8000
INTERNAL_API_URL=http://backend:8000

