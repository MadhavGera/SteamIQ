# Environment variables for Next.js (SteamIQ Frontend)
# ADR 0001, Decision 7: API URLs are ALWAYS read from env — never hardcoded.
# Copy this file to .env.local for local development.

# ── Client-Side API Base URL (Browser Calls) ──────────────────────────────────
# REQUIRED: Must be accessible from the user's web browser.
# - Local dev (make dev): http://localhost:8000
# - Docker Compose: http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── Server-Side API Base URL (SSR / Server Components) ────────────────────────
# OPTIONAL (falls back to NEXT_PUBLIC_API_URL if unset).
# Preferred in containerized setups for direct container-to-container calls.
# - Local dev: http://localhost:8000
# - Docker Compose: http://backend:8000
INTERNAL_API_URL=http://backend:8000

