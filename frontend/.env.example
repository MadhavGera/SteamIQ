# Environment variables for Next.js
# ADR 0001, Decision 7: NEXT_PUBLIC_API_URL is ALWAYS from env — never hardcoded.
# Copy this to .env.local for local dev.

# Points to the backend API
# Local dev: http://localhost:8000
# Docker Compose: http://localhost:8000 (from host browser perspective)
NEXT_PUBLIC_API_URL=http://localhost:8000
